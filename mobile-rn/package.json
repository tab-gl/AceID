{
  "name": "mobile-rn",
  "version": "1.0.0",
  "private": true,
  "description": "Ace ID native client (bare React Native, Android and iOS).",
  "engines": {
    "node": ">= 22.11.0"
  },
  "scripts": {
    "start": "react-native start",
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "assets": "react-native-asset",
    "gen:m3e": "node scripts/gen-m3e-motion.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "jest",
    "bundle:android": "react-native bundle --platform android --dev false --entry-file index.js --bundle-output /tmp/aceid-android.bundle --assets-dest /tmp/aceid-android-assets",
    "bundle:ios": "react-native bundle --platform ios --dev false --entry-file index.js --bundle-output /tmp/aceid-ios.bundle --assets-dest /tmp/aceid-ios-assets"
  },
  "dependencies": {
    "@material/material-color-utilities": "^0.4.0",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@solar-icons/react-native": "^2.7.0",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-app-auth": "^9.0.0",
    "react-native-astryx": "^0.1.3",
    "react-native-blur-overlay": "^3.2.1",
    "react-native-gesture-handler": "^3.5.0",
    "react-native-haptic-feedback": "^3.0.0",
    "react-native-keychain": "^11.0.0",
    "react-native-m3": "^0.2.2",
    "react-native-nitro-modules": "^0.37.2",
    "react-native-reanimated": "^4.8.0",
    "react-native-safe-area-context": "^5.11.1",
    "react-native-svg": "^15.16.1",
    "react-native-worklets": "0.14.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@m3e/web": "2.13.7",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.88.1",
    "@react-native/eslint-config": "0.88.1",
    "@react-native/jest-preset": "0.88.1",
    "@react-native/metro-config": "0.88.1",
    "@react-native/typescript-config": "0.88.1",
    "@types/jest": "^29.5.13",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-native-asset": "^2.1.1",
    "react-test-renderer": "19.3.0",
    "typescript": "^6.0.3"
  }
}
