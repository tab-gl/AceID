# Copy to .env (untracked) and fill in. Only PUBLIC values belong here.
EXPO_PUBLIC_ACEID_ISSUER=https://identity.ace-base.cc
# Optional; defaults to the issuer.
EXPO_PUBLIC_ACEID_API_BASE_URL=
# The registered PUBLIC OIDC client ID. Sign-in shows a configuration error without it.
EXPO_PUBLIC_ACEID_CLIENT_ID=
